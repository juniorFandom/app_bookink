# .gitignore minimal pour Django

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/

# Environnement virtuel
venv/
env/
.env
.venv
ENV/
env.bak/
venv.bak/

# Base de données
*.db
*.sqlite3
db.sqlite3
*.sqlite

# Fichiers médias
/media/
/staticfiles/
/static/
/uploads/

# Logs
*.log
*.log.*
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Fichiers de cache
.cache/
.pytest_cache/
.coverage
htmlcov/
*.cover
.tox/

# Django spécifique
*.mo
*.pot
local_settings.py
.env.local
*.local.py